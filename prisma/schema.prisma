generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

generator zod {
  provider = "zod-prisma-types"
  output   = "../src/generated/zod"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String @default("")
  role     Role   @default(CLIENT)

  @@map("users")
}

enum Role {
  ADMIN
  CLIENT
}